{
  "name": "dsh-token-quota",
  "version": "0.2.0",
  "description": "Token quota guard for DeepSeek Harness: set a token budget per session, and before the context approaches it the agent is paused with a dialog — continue, raise the quota, or stop. DSH Token 限额警戒插件。",
  "icon": "icon.svg",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "token",
    "quota",
    "budget",
    "context",
    "限额"
  ],
  "license": "MIT",
  "author": "Lingwindg <3086751485@qq.com>",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.1.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "scripts": {
    "check": "node --check index.js && node --check lib/client.js"
  }
}
